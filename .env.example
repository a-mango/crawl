# .env.example
# Environment variables used by this project (auto-generated from code).
# Copy this file to .env and update values as needed.

# --- Crawl options (used by the CLI via clap env bindings) ---
# The URL to start crawling from (required)
# Example: https://example.com
CRAWL_START_URL=https://example.com

# The maximum depth to crawl (integer, default: 2)
CRAWL_DEPTH=2

# The domain/scope to limit crawling to (optional). If set, crawler will only
# follow links under this domain.
# Example: example.com
CRAWL_SCOPE=

# Delay between requests in milliseconds (integer, default: 1000)
CRAWL_DELAY_MS=1000

# Custom User-Agent string sent with HTTP requests (default: "rust-crawler/0.2.0")
CRAWL_USER_AGENT=rust-crawler/0.2.0

# Maximum number of concurrent requests (integer, default: 10)
CRAWL_CONCURRENCY=10

# Output file path (optional). If omitted, results are printed to stdout.
# Examples: /data/results.json  or ./results.txt
CRAWL_OUTPUT=

# Quiet mode - when true the program suppresses extra output and prints only URLs.
# Accepts: true | false. By default the program auto-detects TTY and will quiet
# when stdout is not a TTY; setting this explicitly overrides that behavior.
CRAWL_QUIET=false

# Per-request timeout in seconds (integer, default: 30)
CRAWL_TIMEOUT_SECS=30

# Retries for network errors, timeouts, 429 and 5xx responses (integer, default: 3)
CRAWL_MAX_RETRIES=3

# Ignore robots.txt rules and Crawl-delay (true | false, default: false)
CRAWL_IGNORE_ROBOTS=false

# --- Helpful envs (not required by your code, but commonly used) ---
# RUST_LOG controls crate logging levels (used by crates that respect env_logger)
# Example: RUST_LOG=info or RUST_LOG=debug
RUST_LOG=info

# If you run the crawler inside Docker you can also provide variables to the
# container at runtime using `-e` or `--env-file` (docker run) or via docker-compose.
# Example docker run:
#   docker run --rm -e CRAWL_START_URL="https://example.com" your-image:latest
# Example docker run with env file:
#   docker run --rm --env-file .env your-image:latest